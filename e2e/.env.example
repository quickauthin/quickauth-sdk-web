# Credentials for e2e/live-otp-test.js and e2e/server.js — copy to e2e/.env (gitignored).
# If e2e/.env is absent, ../QuickAuthSDKTest/sdk-e2e/.env is used instead.
# Shell variables with the same names take precedence over either file.
#
# Publishable key (pk_test_… / pk_live_…) — the recommended auth mode and the
# default for the live run when set. Safe to ship in a browser page.
QA_PUBLISHABLE_KEY=

# Merchant-backend credentials: mint sessionTokens for --token / --unsafe runs
# (POST /v1/sdk/session) and confirm verifications with GET /v1/auth/status.
# They never reach the browser page.
QA_CLIENT_ID=
QA_CLIENT_SECRET=

# Optional — default phone (E.164) when --phone is not passed / pre-filled in the page.
QA_TEST_PHONE=

# Optional — API host override (default https://api.quickauth.in).
QA_API_BASE_URL=
