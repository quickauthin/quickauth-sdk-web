{
  "name": "@quick-auth/web-sdk",
  "version": "1.0.1",
  "description": "QuickAuth Web SDK — phone OTP authentication and Meta WhatsApp marketing attribution",
  "license": "MIT",
  "author": "QuickAuth",
  "homepage": "https://quickauth.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickauthin/quickauth-sdk-web"
  },
  "keywords": [
    "quickauth",
    "otp",
    "whatsapp",
    "authentication",
    "phone-otp",
    "webotp",
    "attribution",
    "marketing",
    "dpdp",
    "gdpr"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node scripts/flatten-iife.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify:dist",
    "size": "du -h dist/index.esm.js",
    "e2e": "node e2e/live-otp-test.js",
    "e2e:offline": "node e2e/live-otp-test.js --offline",
    "e2e:browser": "node e2e/server.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^9.39.5",
    "happy-dom": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
